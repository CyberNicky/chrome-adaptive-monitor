{
  "manifest_version": 3,
  "name": "Navega • Monitor de recursos",
  "version": "0.9.0",
  "description": "Monitora recursos e adapta novas requisições da aba ativa nos modos Normal, Econômico e Restritivo.",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "sidePanel",
    "storage",
    "notifications",
    "alarms",
    "tabs",
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir Navega"
  },
  "side_panel": {
    "default_path": "ui/panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
